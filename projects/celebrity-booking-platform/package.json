{
  "name": "aurum-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Aurum — luxury celebrity booking & talent management platform (demo)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "rm -f prisma/dev.db && prisma db push && prisma db seed",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
